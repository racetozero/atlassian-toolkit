{
  "name": "atlassian-toolkit",
  "version": "0.0.2",
  "description": "TypeScript SDK for Jira, Confluence, Bitbucket, Trello and Atlassian Admin (Cloud and Data Center) for Node.js, Bun and Deno, built on the atl Rust core",
  "keywords": [
    "atlassian",
    "bitbucket",
    "confluence",
    "jira",
    "sdk",
    "trello"
  ],
  "homepage": "https://github.com/racetozero/atlassian-toolkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/racetozero/atlassian-toolkit.git",
    "directory": "crates/atl-node"
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:native": "cargo build --release && bun scripts/copy-native.mjs",
    "build:ts": "tsc -p tsconfig.json && bun scripts/esm-wrapper.mjs",
    "build": "bun run build:native && bun run build:ts",
    "test": "node --test test/sdk.test.cjs test/esm.test.mjs",
    "test:bun": "bun test test/sdk.test.cjs test/esm.test.mjs",
    "test:deno": "deno test --allow-all test/deno-smoke.mts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
